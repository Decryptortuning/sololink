#!/bin/sh
# Controller station LAN is management-only; flight AP traffic keeps its own path.
set -e
apply_rules() {
    tool=$1
    family=$2
    chain=OPENSOLO_CTRL_LAN
    if [ "$3" = stop ]; then
        while "$tool" -C INPUT -i wlan0 -j "$chain" 2>/dev/null; do
            "$tool" -D INPUT -i wlan0 -j "$chain"
        done
        "$tool" -F "$chain" 2>/dev/null || true
        "$tool" -X "$chain" 2>/dev/null || true
        return
    fi
    "$tool" -N "$chain" 2>/dev/null || "$tool" -F "$chain"
    "$tool" -A "$chain" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    "$tool" -A "$chain" -p tcp --dport 22 -j ACCEPT
    if [ "$family" = 4 ]; then
        "$tool" -A "$chain" -p udp --sport 67 --dport 68 -j ACCEPT
        "$tool" -A "$chain" -p icmp -j ACCEPT
    else
        "$tool" -A "$chain" -p udp --sport 547 --dport 546 -j ACCEPT
        "$tool" -A "$chain" -p ipv6-icmp -j ACCEPT
    fi
    "$tool" -A "$chain" -p udp --dport 5353 -j ACCEPT
    "$tool" -A "$chain" -j DROP
    "$tool" -C INPUT -i wlan0 -j "$chain" 2>/dev/null || "$tool" -I INPUT 1 -i wlan0 -j "$chain"
}
case "$1" in start|stop) ;; *) echo "Usage: $0 {start|stop}" >&2; exit 2 ;; esac
apply_rules iptables 4 "$1"
apply_rules ip6tables 6 "$1"
