#!/bin/sh
# A missing management radio must not create an unbounded reboot loop.
SYS_NET=${SOLO_SYS_NET:-/sys/class/net}
RUN_DIR=${SOLO_RUN_DIR:-/run}
count=0
while [ ! -e "$SYS_NET/wlan0" ] && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
done
if [ -e "$SYS_NET/wlan0" ]; then
    rm -f "$RUN_DIR/sololink-network-unavailable"
    logger -t checknet "wlan0 ready"
else
    : > "$RUN_DIR/sololink-network-unavailable"
    logger -p daemon.err -t checknet "wlan0 absent after bounded wait; keeping STM32 and maintenance services running"
fi
exit 0
